<script>
  // 1. Live Risk Score Calculator
  const riskChecks = Array.from(document.querySelectorAll<HTMLInputElement>("[data-risk-check]"));
  const scoreEl = document.getElementById("risk-score-val");
  const badgeEl = document.getElementById("risk-level-badge");
  const adviceEl = document.getElementById("risk-advice-text");
  const resetRiskBtn = document.getElementById("reset-risk-calc");

  function updateRiskScore() {
    const total = riskChecks.reduce((acc, el) => acc + (el.checked ? Number(el.dataset.weight ?? 0) : 0), 0);
    const capped = Math.min(100, total);
    if (scoreEl) scoreEl.textContent = String(capped);

    if (!badgeEl || !adviceEl || !scoreEl) return;

    if (capped < 20) {
      scoreEl.className = "font-mono text-3xl font-bold text-emerald-300";
      badgeEl.className = "rounded-full border border-emerald-400/40 bg-emerald-400/10 px-3 py-0.5 text-xs font-medium text-emerald-300";
      badgeEl.textContent = "状态稳健 (0–19分)";
      adviceEl.textContent = "当前机场未见高危崩盘前兆。建议保持常规月付或已验证年付，并配置一份 ¥15–¥100 永久不限时包作为日常异构热备。";
    } else if (capped < 50) {
      scoreEl.className = "font-mono text-3xl font-bold text-amber-300";
      badgeEl.className = "rounded-full border border-amber-400/40 bg-amber-400/10 px-3 py-0.5 text-xs font-medium text-amber-300";
      badgeEl.textContent = "中度预警 · 停止长周期续费 (20–49分)";
      adviceEl.textContent = "已触发中度异常指标！请立即停止续费任何半年付/年付套餐，切勿参与限时充值返现活动，并提前导入第二家异构专线订阅。";
    } else {
      scoreEl.className = "font-mono text-3xl font-bold text-rose-400";
      badgeEl.className = "rounded-full border border-rose-400/40 bg-rose-400/10 px-3 py-0.5 text-xs font-medium text-rose-300";
      badgeEl.textContent = "高危跑路警报 · 立即切换主力 (50–100分)";
      adviceEl.textContent = "警告：多项高权重跑路前兆同时触发！该机场随时可能彻底关停拔线。请立即启用光速云或飞猫云/唯兔云等已核验双专线及不限时灾备订阅。";
    }
  }

  riskChecks.forEach((chk) => chk.addEventListener("change", updateRiskScore));
  resetRiskBtn?.addEventListener("click", () => {
    riskChecks.forEach((chk) => {
      chk.checked = false;
    });
    updateRiskScore();
  });

  // 2. 42-Brand Radar Filter
  const radarSearch = document.getElementById("radar-search") as HTMLInputElement | null;
  const radarPills = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-radar-filter]"));
  const radarCards = Array.from(document.querySelectorAll<HTMLElement>("[data-radar-card]"));
  const radarCount = document.getElementById("radar-match-count");
  let activeRadarFilter = "all";

  function applyRadarFilter() {
    const q = (radarSearch?.value ?? "").trim().toLowerCase();
    let count = 0;

    radarCards.forEach((card) => {
      const rank = Number(card.dataset.rank ?? 99);
      const tier = card.dataset.tier ?? "";
      const measured = card.dataset.measured === "yes";
      const unlimited = card.dataset.unlimited === "yes";
      const searchBlob = card.dataset.search ?? "";

      let match = true;
      if (q && !searchBlob.includes(q)) match = false;
      if (match && activeRadarFilter !== "all") {
        if (activeRadarFilter === "measured" && !measured) match = false;
        if (activeRadarFilter === "top10" && rank > 10) match = false;
        if (activeRadarFilter === "unlimited" && !unlimited) match = false;
        if (activeRadarFilter === "archive" && tier !== "archive") match = false;
      }

      card.style.display = match ? "" : "none";
      if (match) count++;
    });

    if (radarCount) radarCount.textContent = String(count);
  }

  radarSearch?.addEventListener("input", applyRadarFilter);
  radarPills.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeRadarFilter = btn.dataset.radarFilter ?? "all";
      radarPills.forEach((b) => {
        const isCurrent = b === btn;
        b.className = isCurrent
          ? "radar-pill cursor-pointer rounded-xl border border-accent bg-accent px-3.5 py-2 text-xs font-semibold text-accent-text"
          : "radar-pill cursor-pointer rounded-xl border border-line bg-bg px-3.5 py-2 text-xs text-ink hover:border-accent";
      });
      applyRadarFilter();
    });
  });

  // 3. Copy Code Buttons
  document.querySelectorAll<HTMLButtonElement>("[data-copy-code]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const code = btn.dataset.copyCode;
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const fb = btn.querySelector(".copy-feedback");
        if (fb) {
          const prev = fb.textContent;
          fb.textContent = "已复制 ✓";
          setTimeout(() => {
            fb.textContent = prev;
          }, 2000);
        }
      } catch {
        // Ignore clipboard errors
      }
    });
  });
</script>
