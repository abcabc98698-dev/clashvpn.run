<script>
  // 1. Rule-Providers Filter
  const ruleSearch = document.getElementById("rule-search") as HTMLInputElement | null;
  const rulePills = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-rule-cat]"));
  const ruleCards = Array.from(document.querySelectorAll<HTMLElement>("[data-rule-card]"));
  const ruleCount = document.getElementById("rule-match-count");
  let activeRuleCat = "all";

  function applyRuleFilter() {
    const q = (ruleSearch?.value ?? "").trim().toLowerCase();
    let count = 0;
    ruleCards.forEach((card) => {
      const cat = card.dataset.cat ?? "";
      const blob = card.dataset.search ?? "";
      let match = true;
      if (q && !blob.includes(q)) match = false;
      if (match && activeRuleCat !== "all" && cat !== activeRuleCat) match = false;
      card.style.display = match ? "" : "none";
      if (match) count++;
    });
    if (ruleCount) ruleCount.textContent = String(count);
  }

  ruleSearch?.addEventListener("input", applyRuleFilter);
  rulePills.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeRuleCat = btn.dataset.ruleCat ?? "all";
      rulePills.forEach((b) => {
        b.className =
          b === btn
            ? "rule-pill cursor-pointer rounded-xl border border-accent bg-accent px-3.5 py-2 text-xs font-semibold text-accent-text"
            : "rule-pill cursor-pointer rounded-xl border border-line bg-bg px-3.5 py-2 text-xs text-ink hover:border-accent";
      });
      applyRuleFilter();
    });
  });

  // 2. Diagnostic Tools Filter
  const diagSearch = document.getElementById("diag-search") as HTMLInputElement | null;
  const diagPills = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-diag-cat]"));
  const diagCards = Array.from(document.querySelectorAll<HTMLElement>("[data-diag-card]"));
  const diagCount = document.getElementById("diag-match-count");
  let activeDiagCat = "all";

  function applyDiagFilter() {
    const q = (diagSearch?.value ?? "").trim().toLowerCase();
    let count = 0;
    diagCards.forEach((card) => {
      const cat = card.dataset.cat ?? "";
      const blob = card.dataset.search ?? "";
      let match = true;
      if (q && !blob.includes(q)) match = false;
      if (match && activeDiagCat !== "all" && cat !== activeDiagCat) match = false;
      card.style.display = match ? "" : "none";
      if (match) count++;
    });
    if (diagCount) diagCount.textContent = String(count);
  }

  diagSearch?.addEventListener("input", applyDiagFilter);
  diagPills.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeDiagCat = btn.dataset.diagCat ?? "all";
      diagPills.forEach((b) => {
        b.className =
          b === btn
            ? "diag-pill cursor-pointer rounded-xl border border-accent bg-accent px-3.5 py-2 text-xs font-semibold text-accent-text"
            : "diag-pill cursor-pointer rounded-xl border border-line bg-bg px-3.5 py-2 text-xs text-ink hover:border-accent";
      });
      applyDiagFilter();
    });
  });

  // 3. Copy YAML / CLI Buttons
  document.querySelectorAll<HTMLButtonElement>("[data-copy-code]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const code = btn.dataset.copyCode;
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const fb = btn.querySelector(".copy-feedback");
        if (fb) {
          const prev = fb.textContent;
          fb.textContent = "已复制 ✓";
          setTimeout(() => {
            fb.textContent = prev;
          }, 2000);
        }
      } catch {
        // Ignore clipboard errors
      }
    });
  });
</script>
