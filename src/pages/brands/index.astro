---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopicMatrixNav from "../../components/TopicMatrixNav.astro";
import PageHeader from "../../components/PageHeader.astro";
import Icon from "../../components/Icon.astro";
import {
  BRANDS,
  DATA_STATUS_META,
  getPrimaryBrand,
  type DataStatus,
} from "../../data/brands";
import {
  AFFILIATE_DISCLOSURE,
  AFFILIATE_REL,
  getBrandLink,
} from "../../data/links";
import { ROUTES } from "../../lib/urls";

const primary = getPrimaryBrand();
const primaryLink = getBrandLink(primary.slug);
const statusList = Object.entries(DATA_STATUS_META) as Array<
  [DataStatus, (typeof DATA_STATUS_META)[DataStatus]]
>;

const itemListSchema = BRANDS.map((b) => ({
  name: b.alias ? `${b.name} (${b.alias})` : b.name,
  url: ROUTES.brandDetail(b.slug),
  description: b.summary,
}));

const directoryFaqs = [
  {
    q: "2026 年最推荐哪一家主力 Clash / VLESS 专线机场？",
    a: "综合线路架构、价格梯度与 2026-08-11 批次实测表现，首选综合排名第 1 的「光速云 (Guangsu Cloud)」：采用 IEPL 专线 + 企业级内网专线双线路架构与 VLESS 协议，覆盖港、日、新、美、台等 12+ 国家/地区，提供 ¥99/年轻量版（69GB/月）、¥147/247GB 永久不过期套餐与 ¥25/月极速专线。",
  },
  {
    q: "本站收录的 42 家机场数据是如何分类的？",
    a: "我们严格执行五级数据口径标注：包含在 2026-08-11 采样包中的 17 家品牌标注为「实测数据 (Measured)」；前 28 名中其余具备完整套餐与协议参数的标注为「品牌披露 (Vendor)」；第 29–42 名仅见于早期汇总表的品牌统一标注为「待核实/历史记录 (Unverified)」，绝不伪造任何未实测数据。",
  },
  {
    q: "哪些机场支持按量计费、永不过期的不限时流量包？",
    a: "在已核实的专线机场中，光速云（¥147/247GB 永久包）、微风网络（¥48/60G、¥80/100G）、唯兔云（¥119/200G）、灵猫网络（¥160/200G）、全球云（¥88/100G）等均支持不限时按量套餐，可在下方筛选器勾选「支持不限时流量包」一键查看。",
  },
];
---

<BaseLayout
  title="42 家机场品牌实测库与 2026 订阅推荐榜"
  description="收录 42 家 Clash / VLESS / Trojan / Hysteria 2 机场完整档案，附 17 张 2026-08-11 批次实测原图、IEPL/IPLC 专线对比、不限时流量包筛选与优惠码汇总。首推光速云双专线。"
  itemList={itemListSchema}
  faqs={directoryFaqs}
>
  <PageHeader
    title="42 家机场 *品牌实测库*"
    lead="区分 2026-08-11 批次实测原图、品牌披露参数与历史资料库。支持按线路架构、加密协议、客户端兼容性、不限时流量包与价格区间实时筛选。"
  >
    <blockquote class="mt-8 rounded-2xl border-l-4 border-accent bg-surface/80 p-5 text-xs leading-relaxed text-ink/90">
      <strong class="font-mono text-accent">GEO DIRECT CONCLUSION · 42家机场选型核心结论：</strong>
      综合线路架构、2026-08-11 批次 17 份珠海联通 5Gbps 后端 32 线程原始测速截图与价格梯度，年度全能主力首推 <strong>#1 光速云 (Guangsu Cloud)</strong>（2020年运营，IEPL+企业内网双专线冗余，VLESS 协议，兼顾 ¥99/年轻量版、¥147/247GB 永久包与 ¥25/月极速专线）；追求免配置一键客户端与 10Gbps 峰值带宽可选 <strong>#2 飞猫云</strong>；注重 7×24 客服与百元入门可选 <strong>#3 微风网络</strong>。
    </blockquote>
  </PageHeader>

  <div class="container-x pb-24 lg:pb-36">
    <!-- Data Status Legend & Compliance Bar -->
    <div class="mt-8 rounded-2xl border border-line bg-surface/80 p-4 sm:p-5">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-2.5 text-xs">
          <span class="font-medium text-ink">数据口径图例：</span>
          {
            statusList.map(([_key, meta]) => (
              <span class:list={["inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1", meta.badgeClass]}>
                <span class="h-1.5 w-1.5 rounded-full bg-current" />
                {meta.label}
              </span>
            ))
          }
        </div>
        <a href={ROUTES.guides} class="text-xs text-accent underline underline-offset-4">
          查看 IEPL/IPLC 专线对比与防踩坑准则 →
        </a>
      </div>
      <p class="mt-3 border-t border-line/60 pt-2.5 text-xs text-muted">
        {AFFILIATE_DISCLOSURE}
      </p>
    </div>

    <!-- #1 Primary Recommendation Spotlight: 光速云 -->
    <section id="top-picks" class="mt-12 scroll-mt-28" aria-labelledby="spotlight-heading">
      <div class="relative overflow-hidden rounded-3xl border-2 border-accent bg-surface p-6 sm:p-8 lg:p-10">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="rounded-full bg-accent px-3.5 py-1 text-xs font-bold text-accent-text">
              TOP 1 · 年度主力首选
            </span>
            <span class="rounded-full border border-emerald-400/40 bg-emerald-400/10 px-3 py-1 text-xs text-emerald-300">
              已含 2026-08-11 实测原图
            </span>
            <span class="rounded-full border border-line bg-bg/70 px-3 py-1 font-mono text-xs text-accent">
              {primary.lineType} · {primary.protocols.join(" / ")}
            </span>
          </div>
          <div class="font-mono text-sm text-accent">
            成立年份：<strong class="text-ink">{primary.foundedYear}</strong> · 核验批次：{primary.verifiedDate}
          </div>
        </div>

        <div class="mt-6 grid gap-8 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <h2 id="spotlight-heading" class="text-2xl font-semibold text-ink sm:text-3xl">
              <a href={ROUTES.brandDetail(primary.slug)} class="hover:text-accent">
                {primary.name} {primary.alias ? `(${primary.alias})` : ""}
              </a>
            </h2>
            <p class="mt-4 text-base leading-relaxed text-ink/90">
              {primary.editorialOverview}
            </p>

            <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
              <div class="rounded-xl border border-line bg-bg/60 p-3.5">
                <div class="text-xs text-muted">轻量年付</div>
                <div class="mt-1 font-mono text-lg font-semibold text-accent">¥99/年</div>
                <div class="text-[11px] text-muted">69GB/月 · 折 ¥8.25/月</div>
              </div>
              <div class="rounded-xl border border-line bg-bg/60 p-3.5">
                <div class="text-xs text-muted">147 永久套餐</div>
                <div class="mt-1 font-mono text-lg font-semibold text-accent">¥147/一次性</div>
                <div class="text-[11px] text-muted">247GB 永久不过期</div>
              </div>
              <div class="rounded-xl border border-line bg-bg/60 p-3.5">
                <div class="text-xs text-muted">极速专线月付</div>
                <div class="mt-1 font-mono text-lg font-semibold text-ink">¥25/月</div>
                <div class="text-[11px] text-muted">168GB/月 · 全球IPLC</div>
              </div>
              <div class="rounded-xl border border-line bg-bg/60 p-3.5">
                <div class="text-xs text-muted">香港实测峰值</div>
                <div class="mt-1 font-mono text-lg font-semibold text-ink">22ms / 529M</div>
                <div class="text-[11px] text-muted">单节点最高 2.5Gbps</div>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a href={ROUTES.brandDetail(primary.slug)} class="btn btn-primary">
                阅读光速云完整评测与实测图 <Icon name="arrow-right" class="icon-shift" />
              </a>
              {
                primaryLink?.registerUrl && (
                  <a
                    href={primaryLink.registerUrl}
                    target="_blank"
                    rel={AFFILIATE_REL}
                    class="btn btn-secondary"
                  >
                    访问光速云官网注册 ↗
                  </a>
                )
              }
              {
                primaryLink?.promoCode && (
                  <button
                    type="button"
                    data-copy-code={primaryLink.promoCode}
                    class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-accent/40 bg-accent/10 px-4 py-2.5 font-mono text-xs text-accent transition hover:bg-accent/20"
                    title="点击复制优惠码"
                  >
                    <span>优惠码：{primaryLink.promoCode} ({primaryLink.promoBenefit})</span>
                    <span class="copy-feedback underline">点击复制</span>
                  </button>
                )
              }
            </div>
          </div>

          <div class="lg:col-span-5">
            {
              primary.speedtestImage && (
                <div class="rounded-2xl border border-line bg-bg/75 p-4">
                  <div class="flex items-center justify-between pb-2.5 text-xs">
                    <span class="font-mono text-accent">2026-08-11 实测长图预览</span>
                    <a href={ROUTES.brandDetail(primary.slug)} class="text-muted hover:text-accent">
                      查看完整指标 →
                    </a>
                  </div>
                  <a href={ROUTES.brandDetail(primary.slug)} class="block overflow-hidden rounded-xl border border-line">
                    <img
                      src={primary.speedtestImage.file}
                      alt="光速云 2026-08-11 节点延迟与速度实测截图"
                      loading="eager"
                      decoding="async"
                      class="max-h-56 w-full object-cover object-top transition duration-300 hover:scale-[1.02]"
                    />
                  </a>
                  <p class="mt-2.5 text-[11px] leading-relaxed text-muted">
                    测试时间：{primary.speedtestImage.testedAt} · 图内显示协议：{primary.speedtestImage.protocolDisplayed} · 覆盖港、日、新、美、台等 12+ 国家/地区。
                  </p>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Multi-Dimensional Filter Controls -->
    <section class="mt-14" aria-labelledby="filter-heading">
      <div class="rounded-2xl border border-line bg-surface p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-4">
          <h2 id="filter-heading" class="text-lg font-medium text-ink">
            按条件筛选与排序 42 家机场
          </h2>
          <div class="flex items-center gap-3 text-sm">
            <span class="text-muted">
              当前匹配：<strong id="brand-match-count" class="font-mono text-accent">{BRANDS.length}</strong> / {BRANDS.length} 家
            </span>
            <button
              type="button"
              id="reset-filters-btn"
              class="cursor-pointer rounded-lg border border-line px-3 py-1 text-xs text-muted transition hover:border-accent hover:text-accent"
            >
              重置筛选
            </button>
          </div>
        </div>

        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
          <div class="lg:col-span-2">
            <label for="filter-search" class="block text-xs text-muted">关键词搜索</label>
            <input
              id="filter-search"
              type="search"
              placeholder="搜品牌名（如光速云、飞猫）、协议或特点…"
              class="mt-1.5 w-full rounded-xl border border-line bg-bg px-3.5 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none"
            />
          </div>

          <div>
            <label for="filter-tier" class="block text-xs text-muted">评测梯队与实测图</label>
            <select
              id="filter-tier"
              class="mt-1.5 w-full rounded-xl border border-line bg-bg px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none"
            >
              <option value="all">全部 42 家品牌</option>
              <option value="top10">Top 10 主力推荐梯队</option>
              <option value="measured">已含 2026-08-11 实测图 (17)</option>
              <option value="unlimited">支持永久/不限时流量包</option>
              <option value="evaluated">前 28 名完整档案品牌</option>
              <option value="archive">第 29–42 名历史待核实</option>
            </select>
          </div>

          <div>
            <label for="filter-line" class="block text-xs text-muted">线路架构</label>
            <select
              id="filter-line"
              class="mt-1.5 w-full rounded-xl border border-line bg-bg px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none"
            >
              <option value="all">全部线路类型</option>
              <option value="IEPL">IEPL 专线</option>
              <option value="IPLC">IPLC 专线</option>
              <option value="双线路">双专线冗余 (光速云)</option>
            </select>
          </div>

          <div>
            <label for="filter-protocol" class="block text-xs text-muted">传输协议</label>
            <select
              id="filter-protocol"
              class="mt-1.5 w-full rounded-xl border border-line bg-bg px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none"
            >
              <option value="all">全部协议</option>
              <option value="VLESS">VLESS</option>
              <option value="Trojan">Trojan</option>
              <option value="Hysteria 2">Hysteria 2</option>
              <option value="Shadowsocks">Shadowsocks (SS)</option>
            </select>
          </div>

          <div>
            <label for="filter-sort" class="block text-xs text-muted">排序方式 / 客户端</label>
            <select
              id="filter-sort"
              class="mt-1.5 w-full rounded-xl border border-line bg-bg px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none"
            >
              <option value="rank">按综合推荐排名 (默认)</option>
              <option value="price-month">按折算最低月费升序</option>
              <option value="universal-only">支持通用订阅导入 (Clash/小火箭)</option>
              <option value="dedicated-only">仅专属一键客户端</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Empty State -->
      <div id="filter-empty-state" class="mt-8 hidden rounded-2xl border border-line bg-surface p-10 text-center">
        <p class="text-lg text-ink">没有找到符合当前筛选组合的机场品牌</p>
        <p class="mt-2 text-sm text-muted">您可以尝试放宽协议或线路条件，或直接查看综合排名第 1 的光速云。</p>
        <div class="mt-5 flex justify-center gap-3">
          <button type="button" id="empty-reset-btn" class="btn btn-primary cursor-pointer">
            显示全部 42 家品牌
          </button>
          <a href={ROUTES.brandDetail("guangsuyun")} class="btn btn-secondary">
            查看榜首光速云
          </a>
        </div>
      </div>

      <!-- 42 Brands Grid -->
      <ul id="brands-grid" class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          BRANDS.map((brand) => {
            const linkInfo = getBrandLink(brand.slug);
            const statusMeta = DATA_STATUS_META[brand.dataStatus];
            const hasImage = Boolean(brand.speedtestImage?.file);
            const isPrimary = brand.rank === 1;
            const isArchive = brand.tier === "archive";

            return (
              <li
                data-brand-card
                data-rank={brand.rank}
                data-tier={brand.tier}
                data-measured={hasImage ? "yes" : "no"}
                data-unlimited={brand.hasUnlimitedTimePack ? "yes" : "no"}
                data-line={brand.lineType}
                data-protocols={brand.protocols.join(",")}
                data-client={brand.clientSupport}
                data-month={brand.monthlyMinPrice ?? 9999}
                data-search={`${brand.name} ${brand.alias ?? ""} ${brand.lineType} ${brand.protocols.join(" ")} ${brand.summary} ${brand.highlights.join(" ")}`.toLowerCase()}
                class:list={[
                  "flex flex-col justify-between rounded-2xl border p-6 transition",
                  isPrimary
                    ? "border-accent bg-surface shadow-[0_0_30px_rgba(220,253,53,0.08)]"
                    : isArchive
                      ? "border-line/70 bg-surface/50"
                      : "border-line bg-surface hover:border-accent/50",
                ]}
              >
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                      <span
                        class:list={[
                          "inline-flex items-center rounded-md px-2 py-0.5 font-mono text-xs font-bold",
                          isPrimary
                            ? "bg-accent text-accent-text"
                            : brand.rank <= 10
                              ? "border border-accent/40 bg-accent/15 text-accent"
                              : "border border-line bg-bg text-muted",
                        ]}
                      >
                        #{brand.rank}
                      </span>
                      <span class:list={["rounded-full border px-2.5 py-0.5 text-[11px]", statusMeta.badgeClass]}>
                        {statusMeta.label}
                      </span>
                      {hasImage && (
                        <span class="rounded-full border border-accent/35 bg-accent/10 px-2 py-0.5 font-mono text-[11px] text-accent">
                          含实测图
                        </span>
                      )}
                    </div>
                    <span class="font-mono text-xs text-muted">
                      {brand.foundedYear}
                    </span>
                  </div>

                  <h3 class="mt-4 text-xl font-semibold text-ink">
                    <a href={ROUTES.brandDetail(brand.slug)} class="hover:text-accent">
                      {brand.name}
                      {brand.alias && <span class="ml-1.5 text-sm font-normal text-muted">({brand.alias})</span>}
                    </a>
                  </h3>
                  <p class="mt-1 text-xs text-accent">{brand.lineType}</p>

                  <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted">
                    {brand.summary}
                  </p>

                  <dl class="mt-4 grid grid-cols-2 gap-2.5 rounded-xl border border-line/80 bg-bg/50 p-3 text-xs">
                    <div>
                      <dt class="text-muted">传输协议</dt>
                      <dd class="mt-0.5 font-mono font-medium text-ink">
                        {brand.protocols.join(" / ")}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-muted">入门门槛</dt>
                      <dd class="mt-0.5 font-mono font-medium text-accent">
                        {brand.entryPriceLabel}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-muted">客户端方式</dt>
                      <dd class="mt-0.5 text-ink">
                        {brand.clientSupportLabel.slice(0, 16)}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-muted">不限时流量包</dt>
                      <dd class="mt-0.5 font-mono text-ink">
                        {brand.hasUnlimitedTimePack ? "支持不限时包" : "周期重置套餐"}
                      </dd>
                    </div>
                  </dl>
                </div>

                <div class="mt-5 border-t border-line/60 pt-3">
                  {linkInfo?.promoCode && (
                    <div class="mb-3 flex items-center justify-between rounded-lg border border-line bg-bg/70 px-3 py-1.5 text-xs">
                      <span class="truncate font-mono text-muted">
                        券码 <strong class="text-accent">{linkInfo.promoCode}</strong> · {linkInfo.promoBenefit ?? "专属折扣"}
                      </span>
                      <button
                        type="button"
                        data-copy-code={linkInfo.promoCode}
                        class="ml-2 shrink-0 cursor-pointer font-mono text-[11px] text-accent underline"
                      >
                        <span class="copy-feedback">复制</span>
                      </button>
                    </div>
                  )}

                  <div class="flex items-center gap-2.5">
                    <a
                      href={ROUTES.brandDetail(brand.slug)}
                      class="flex-1 rounded-xl border border-accent bg-accent px-3.5 py-2.5 text-center text-xs font-semibold text-accent-text transition hover:opacity-90"
                    >
                      查看评测详情
                    </a>
                    {linkInfo?.registerUrl && (
                      <a
                        href={linkInfo.registerUrl}
                        target="_blank"
                        rel={AFFILIATE_REL}
                        class="rounded-xl border border-line bg-bg px-3.5 py-2.5 text-xs text-ink transition hover:border-accent hover:text-accent"
                      >
                        官网注册 ↗
                      </a>
                    )}
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>

    <!-- Directory FAQ Section -->
    <section class="mt-20 border-t border-line pt-14" aria-labelledby="dir-faq-heading">
      <h2 id="dir-faq-heading" class="h-section">
        <span class="dim">机场选型</span> <span class="hl">常见问题</span>
      </h2>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {
          directoryFaqs.map((faq) => (
            <details open class="group rounded-2xl border border-line bg-surface p-6">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-2">
                <h3 class="text-lg font-medium text-ink group-hover:text-accent">{faq.q}</h3>
                <span class="shrink-0 font-mono text-xs text-muted group-open:text-accent">展开/收起</span>
              </summary>
              <p class="mt-3 border-t border-line/60 pt-3 text-sm leading-relaxed text-muted">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
  <TopicMatrixNav />
</BaseLayout>

<script>
  const searchInput = document.getElementById("filter-search") as HTMLInputElement | null;
  const tierSelect = document.getElementById("filter-tier") as HTMLSelectElement | null;
  const lineSelect = document.getElementById("filter-line") as HTMLSelectElement | null;
  const protocolSelect = document.getElementById("filter-protocol") as HTMLSelectElement | null;
  const sortSelect = document.getElementById("filter-sort") as HTMLSelectElement | null;
  const resetBtn = document.getElementById("reset-filters-btn");
  const emptyResetBtn = document.getElementById("empty-reset-btn");
  const countEl = document.getElementById("brand-match-count");
  const emptyEl = document.getElementById("filter-empty-state");
  const gridEl = document.getElementById("brands-grid");

  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-brand-card]"));

  function applyFilters() {
    if (!gridEl) return;
    const q = (searchInput?.value ?? "").trim().toLowerCase();
    const tier = tierSelect?.value ?? "all";
    const line = lineSelect?.value ?? "all";
    const proto = protocolSelect?.value ?? "all";
    const sort = sortSelect?.value ?? "rank";

    let visibleCount = 0;

    cards.forEach((card) => {
      const rank = Number(card.dataset.rank ?? "99");
      const cardTier = card.dataset.tier ?? "";
      const measured = card.dataset.measured === "yes";
      const unlimited = card.dataset.unlimited === "yes";
      const cardLine = card.dataset.line ?? "";
      const cardProtos = card.dataset.protocols ?? "";
      const cardClient = card.dataset.client ?? "";
      const searchBlob = card.dataset.search ?? "";

      let match = true;

      if (q && !searchBlob.includes(q)) match = false;

      if (match && tier !== "all") {
        if (tier === "top10" && rank > 10) match = false;
        if (tier === "measured" && !measured) match = false;
        if (tier === "unlimited" && !unlimited) match = false;
        if (tier === "evaluated" && cardTier === "archive") match = false;
        if (tier === "archive" && cardTier !== "archive") match = false;
      }

      if (match && line !== "all") {
        if (!cardLine.includes(line)) match = false;
      }

      if (match && proto !== "all") {
        if (!cardProtos.includes(proto)) match = false;
      }

      if (match && sort === "universal-only" && cardClient !== "both" && cardClient !== "third-party") {
        match = false;
      }
      if (match && sort === "dedicated-only" && cardClient !== "custom-only") {
        match = false;
      }

      card.style.display = match ? "" : "none";
      if (match) visibleCount++;
    });

    const sorted = [...cards].sort((a, b) => {
      if (sort === "price-month") {
        return Number(a.dataset.month ?? 9999) - Number(b.dataset.month ?? 9999);
      }
      return Number(a.dataset.rank ?? 99) - Number(b.dataset.rank ?? 99);
    });

    sorted.forEach((c) => gridEl.appendChild(c));

    if (countEl) countEl.textContent = String(visibleCount);
    if (emptyEl) {
      emptyEl.classList.toggle("hidden", visibleCount > 0);
    }
  }

  function resetAll() {
    if (searchInput) searchInput.value = "";
    if (tierSelect) tierSelect.value = "all";
    if (lineSelect) lineSelect.value = "all";
    if (protocolSelect) protocolSelect.value = "all";
    if (sortSelect) sortSelect.value = "rank";
    applyFilters();
  }

  searchInput?.addEventListener("input", applyFilters);
  tierSelect?.addEventListener("change", applyFilters);
  lineSelect?.addEventListener("change", applyFilters);
  protocolSelect?.addEventListener("change", applyFilters);
  sortSelect?.addEventListener("change", applyFilters);
  resetBtn?.addEventListener("click", resetAll);
  emptyResetBtn?.addEventListener("click", resetAll);

  document.querySelectorAll<HTMLButtonElement>("[data-copy-code]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const code = btn.dataset.copyCode;
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const fb = btn.querySelector(".copy-feedback");
        if (fb) {
          const prev = fb.textContent;
          fb.textContent = "已复制 ✓";
          setTimeout(() => {
            fb.textContent = prev;
          }, 2000);
        }
      } catch {
        // Fallback ignored
      }
    });
  });
</script>
