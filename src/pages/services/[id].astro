---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopicMatrixNav from "../../components/TopicMatrixNav.astro";
import PageHeader from "../../components/PageHeader.astro";
import ServiceArt from "../../components/ServiceArt.astro";
import Icon from "../../components/Icon.astro";
import { SITE } from "../../config";
import { ROUTES } from "../../lib/urls";

export async function getStaticPaths() {
  const allServices = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
  return allServices.map((service) => ({
    params: { id: service.id },
    props: {
      service,
      related: allServices.filter((item) => item.id !== service.id),
    },
  }));
}

interface Props {
  service: CollectionEntry<"services">;
  related: CollectionEntry<"services">[];
}

const { service, related } = Astro.props;
const { Content } = await render(service);
const {
  title,
  description,
  tags,
  summary,
  art,
  priceFrom,
  duration,
  deliverables,
  datePublished,
  dateModified,
  author,
  category,
  pageRole,
  primaryKeyword,
  secondaryKeywords,
  contentCluster,
  faqs,
  internalLinkPlan,
} = service.data;

const metaDescription = description ?? `${summary} — ${SITE.name} 深度选型与配置专题。`;
const allKeywords = [
  ...(primaryKeyword ? [primaryKeyword] : []),
  ...(secondaryKeywords ?? []),
];
---

<BaseLayout
  title={`${title}：2026 深度评测、配置规则与故障排查指南`}
  description={metaDescription}
  breadcrumbLabel={title}
  faqs={faqs}
  service={{
    id: service.id,
    title,
    summary,
    priceFrom,
    deliverables,
  }}
  article={{
    headline: `${title}：2026 深度评测、配置规则与故障排查指南`,
    description: metaDescription,
    datePublished,
    dateModified,
    author,
    section: category ?? contentCluster,
    keywords: allKeywords,
  }}
>
  <nav aria-label="面包屑导航" class="container-x pt-10 text-sm text-muted">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a href={ROUTES.home} class="hover:text-accent">首页</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={ROUTES.services} class="hover:text-accent">六大选型场景</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink">{title}</li>
    </ol>
  </nav>

  <PageHeader title={`*${title}*`} lead={summary}>
    <p class="mt-4 text-base text-accent">{tags}</p>
    <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-muted">
      {category && (
        <span class="rounded-full border border-line bg-surface px-3 py-1 text-ink">
          专题分类：{category}
        </span>
      )}
      {author && (
        <span class="rounded-full border border-line bg-surface px-3 py-1">
          撰写：{author}
        </span>
      )}
      {datePublished && (
        <span class="font-mono">
          发布于 <time datetime={datePublished}>{datePublished}</time>
        </span>
      )}
      {dateModified && (
        <span class="font-mono text-accent">
          最后核验更新：<time datetime={dateModified}>{dateModified}</time>
        </span>
      )}
    </div>
  </PageHeader>

  <div class="container-x pb-24 lg:pb-36">
    <section class="grid gap-10 pt-8 lg:grid-cols-12 lg:gap-12" aria-labelledby="service-scope-title">
      <!-- Left Sticky Sidebar: Art, Key Metrics, Deliverables & Cluster Links -->
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-28 space-y-6">
          <div class="rounded-2xl bg-accent p-6 text-accent-text">
            <ServiceArt kind={art} />
          </div>

          <dl class="grid grid-cols-2 gap-4 rounded-2xl border border-line bg-surface p-5">
            {
              priceFrom && (
                <div>
                  <dt class="text-xs text-muted">参考门槛</dt>
                  <dd class="mt-1 font-mono text-xl font-semibold text-accent">{priceFrom}</dd>
                </div>
              )
            }
            {
              duration && (
                <div>
                  <dt class="text-xs text-muted">适用模式</dt>
                  <dd class="mt-1 text-lg font-light text-ink">{duration}</dd>
                </div>
              )
            }
            {
              contentCluster && (
                <div class="col-span-2 border-t border-line/60 pt-3">
                  <dt class="text-xs text-muted">所属主题集群 (Topic Cluster)</dt>
                  <dd class="mt-1 text-xs font-medium text-ink">{contentCluster}</dd>
                </div>
              )
            }
            {
              pageRole && (
                <div class="col-span-2 border-t border-line/60 pt-3">
                  <dt class="text-xs text-muted">内容节点角色</dt>
                  <dd class="mt-1 text-xs text-muted">{pageRole}</dd>
                </div>
              )
            }
          </dl>

          {
            deliverables.length > 0 && (
              <div class="rounded-2xl border border-line bg-surface p-5 sm:p-6">
                <h2 class="text-base font-semibold text-ink">本篇深度指南核心收获</h2>
                <ul class="mt-4 space-y-2.5 text-xs text-muted">
                  {deliverables.map((d) => (
                    <li class="flex gap-2.5">
                      <Icon name="check" size={16} class="mt-0.5 shrink-0 text-accent" />
                      <span class="text-ink/90">{d}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            internalLinkPlan && (
              <nav aria-label="关联品牌与上级专题" class="rounded-2xl border border-line bg-surface p-5 text-xs">
                <h3 class="font-semibold text-accent uppercase">站内知识矩阵快速直达</h3>
                {internalLinkPlan.parent.length > 0 && (
                  <div class="mt-3">
                    <div class="text-muted">所属上级核心专题：</div>
                    <ul class="mt-1.5 space-y-1.5">
                      {internalLinkPlan.parent.map((link) => (
                        <li>
                          <a href={link.url} class="text-ink underline underline-offset-4 hover:text-accent">
                            ↑ {link.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {internalLinkPlan.children.length > 0 && (
                  <div class="mt-4 border-t border-line/60 pt-3">
                    <div class="text-muted">本场景实测代表品牌：</div>
                    <ul class="mt-1.5 space-y-1.5">
                      {internalLinkPlan.children.map((link) => (
                        <li>
                          <a href={link.url} class="text-accent underline underline-offset-4 hover:opacity-85">
                            → {link.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </nav>
            )
          }
        </div>
      </aside>

      <!-- Right Main Content Column -->
      <article class="lg:col-span-8">
        <h2 id="service-scope-title" class="sr-only">场景深度分析与配置实战</h2>
        <div class="prose-content">
          <Content />
        </div>

        <!-- Visible Long-Tail FAQ Section (Synced with FAQPage JSON-LD) -->
        {
          faqs && faqs.length > 0 && (
            <section class="mt-16 border-t border-line pt-12" aria-labelledby="scenario-faq-heading">
              <div class="flex items-center gap-2 font-mono text-xs text-accent uppercase">
                <span>Long-Tail FAQ · 场景高频延伸疑问</span>
              </div>
              <h2 id="scenario-faq-heading" class="mt-2 text-2xl font-semibold text-ink">
                关于「{title}」的 {faqs.length} 个关键实操问答
              </h2>
              <div class="mt-6 space-y-4">
                {faqs.map((faq) => (
                  <details open class="group rounded-2xl border border-line bg-surface p-6">
                    <summary class="flex cursor-pointer list-none items-start justify-between gap-3">
                      <h3 class="text-base font-semibold text-ink group-hover:text-accent">{faq.q}</h3>
                      <span class="shrink-0 font-mono text-xs text-muted group-open:text-accent">展开/收起</span>
                    </summary>
                    <p class="mt-3 border-t border-line/60 pt-3 text-sm leading-relaxed text-muted">{faq.a}</p>
                  </details>
                ))}
              </div>
            </section>
          )
        }

        <div class="mt-12 flex flex-wrap gap-4 border-t border-line pt-8">
          <a href={ROUTES.brandDetail("guangsuyun")} class="btn btn-primary">
            查看榜首推荐：光速云双专线评测 <Icon name="arrow-right" class="icon-shift" />
          </a>
          <a href={ROUTES.brands} class="btn btn-secondary">浏览全部 42 家机场库</a>
          <a href={ROUTES.clients} class="btn btn-secondary">下载 6 大平台开源客户端</a>
        </div>
      </article>
    </section>

    <section class="mt-24 border-t border-line pt-16" aria-labelledby="related-services-title">
      <h2 id="related-services-title" class="h-section">
        <span class="dim">横向探索</span> <span class="hl">其他选型场景</span>
      </h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          related.map((item) => (
            <li class="card flex flex-col justify-between p-6 transition hover:border-accent/60">
              <div>
                <h3 class="text-xl font-medium">
                  <a href={ROUTES.serviceDetail(item.id)} class="hover:text-accent">
                    {item.data.title}
                  </a>
                </h3>
                <p class="mt-2 text-sm text-accent">{item.data.tags}</p>
                <p class="mt-4 text-sm leading-relaxed text-muted">{item.data.summary}</p>
              </div>
              <a
                href={ROUTES.serviceDetail(item.id)}
                class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-accent hover:underline"
              >
                阅读《{item.data.title}》深度指南 <Icon name="arrow-right" size={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
  <TopicMatrixNav />
</BaseLayout>
