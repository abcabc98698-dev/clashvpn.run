---
import fontUrl from "@fontsource/questrial/files/questrial-latin-400-normal.woff2?url";
import { SITE } from "../config";
import {
  jsonLdString,
  pageGraphJsonLd,
  type ArticleSchemaInput,
  type FaqSchemaInput,
  type ItemListSchemaInput,
  type ServiceSchemaInput,
} from "../lib/schema";
import { ASSETS, ROUTES, assetUrl, canonicalUrl } from "../lib/urls";

export interface Props {
  /** Page title without the site name. Leave out on the home page. */
  title?: string;
  description?: string;
  /** Path or absolute URL of a 1200×630 image. */
  image?: string;
  noindex?: boolean;
  /** Optional service entity when rendering a service or brand detail page. */
  service?: ServiceSchemaInput;
  /** Optional TechArticle entity when rendering an in-depth guide/scenario article. */
  article?: ArticleSchemaInput;
  /** Optional authentic visible FAQs for FAQPage schema. */
  faqs?: FaqSchemaInput[];
  /** Optional ItemList entries for directory/ranking pages. */
  itemList?: ItemListSchemaInput[];
  /** Optional custom label for the final breadcrumb item. */
  breadcrumbLabel?: string;
}

const {
  title,
  description = SITE.description,
  image = ASSETS.ogImage,
  noindex = false,
  service,
  article,
  faqs,
  itemList,
  breadcrumbLabel,
} = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const canonical = canonicalUrl(Astro.url.pathname, site);
const ogImage = assetUrl(image, site);
const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
const ogType = article ? "article" : "website";
const schemaData = pageGraphJsonLd({
  site,
  pathname: Astro.url.pathname,
  title: fullTitle,
  description,
  image,
  service,
  article,
  faqs,
  itemList,
  breadcrumbLabel,
});
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#040319" />
<link rel="icon" href={ASSETS.faviconSvg} type="image/svg+xml" />
<link rel="apple-touch-icon" href={ASSETS.appleTouchIcon} />
<link rel="manifest" href={ASSETS.manifest} />
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
<link rel="sitemap" type="application/xml" title="Sitemap Index" href={ROUTES.sitemap} />
<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />

{/* Search engine webmaster verification meta tags (SSR/SSG static output) */}
{SITE.verification?.google && <meta name="google-site-verification" content={SITE.verification.google} />}
{SITE.verification?.bing && <meta name="msvalidate.01" content={SITE.verification.bing} />}
{SITE.verification?.baidu && <meta name="baidu-site-verification" content={SITE.verification.baidu} />}
{SITE.verification?.shenma && <meta name="shenma-site-verification" content={SITE.verification.shenma} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />

{article?.datePublished && <meta property="article:published_time" content={article.datePublished} />}
{article?.dateModified && <meta property="article:modified_time" content={article.dateModified} />}
{article?.author && <meta property="article:author" content={article.author} />}
{article?.section && <meta property="article:section" content={article.section} />}
{article?.keywords?.map((kw) => <meta property="article:tag" content={kw} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={jsonLdString(schemaData)} />
