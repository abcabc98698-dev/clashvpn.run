---
/** 12. Final call to action: a small line, a heading that fills on scroll, and the accent button. */
import FillLines from "../FillLines.astro";
import { SITE } from "../../config";
---

<section class="final-cta" aria-labelledby="cta-title">
  <div class="container-x cta-col">
    <p class="cta-kicker">准备好锁定适合您的稳定节点了吗？</p>
    <FillLines
      as="h2"
      id="cta-title"
      class="cta-title"
      lines={["浏览 *42家机场* 实测档案，", "或查看榜首 *光速云* 深度评测。"]}
      ranges={[
        [20, 50],
        [30, 60],
      ]}
    />
    <a href={SITE.cta.href} class="btn btn-primary cta-btn">进入机场品牌库</a>
  </div>
</section>

<style>
  .final-cta {
    padding-block: 191px;
  }
  .cta-kicker {
    font-size: min(4.471307vw, 22px);
    line-height: 1.4;
    color: var(--c-ink);
  }
  .cta-col :global(.cta-title) {
    font-size: min(7.739547vw, 52px);
    line-height: 1.3;
  }
  .cta-btn {
    margin-top: 51px;
  }
  @media (min-width: 751px) {
    .final-cta {
      display: grid;
      align-content: center;
      height: 100vh;
      padding-block: 0;
    }
    .cta-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .cta-btn {
      margin-top: 52.8px;
    }
  }
</style>
