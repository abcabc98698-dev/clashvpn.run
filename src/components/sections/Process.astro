---
/**
 * 11. Process: an accent panel that slides in from the left edge of the screen as it scrolls in,
 * next to turning orbits that stay in place (sticky). Each step = dot + title + paragraph; when a
 * step reaches the screen its dot opens, its title tilts in and its paragraph is wiped up into
 * view ([data-enter] in effects.css). Edit the steps below.
 */
import Orbits from "../Orbits.astro";

const steps = [
  {
    title: "01 · 明确用途与流量档位",
    body: "先区分日常需求：仅用于网页查阅、Telegram 与 ChatGPT 对话，每月 50GB–100GB（如光速云 ¥99/年轻量包）完全够用；若高频观看 YouTube 4K、Netflix 或跨区 TikTok 运营，建议选择 130GB–300GB/月以上的 IEPL 专线套餐。",
  },
  {
    title: "02 · 核查客户端与协议兼容",
    body: "优先选择支持标准通用订阅（Clash Verge Rev / Mihomo / Shadowrocket / Hiddify / 软路由）且采用 VLESS、Trojan 或 Hysteria 2 协议的专线机场；零基础用户也可按需挑选提供一键专属客户端的品牌。",
  },
  {
    title: "03 · 先测月付或小额不限时包",
    body: "无论机场纸面带宽多高，不同省份的电信、联通、移动宽带在晚高峰（20:00–23:00）表现各异。使用本站汇总的 8 折优惠码（如光速云 gsu8888），先以月付或小流量包实测本地延迟与流媒体解锁，满意后再升级年付。",
  },
  {
    title: "04 · 配置规则分流与备用链路",
    body: "导入订阅后开启 Rule（规则分流）模式，让国内流量直连、AI 与流媒体流量精准走对应原生节点。重度办公用户建议额外储备一份按量计费的「永久不限时流量包」，彻底告别特殊时期单点失联风险。",
  },
];
---

<section class="process" aria-labelledby="process-title">
  <div class="process-panel">
    <h2 id="process-title" class="sr-only">科学选型与订阅配置四步法</h2>
    <ol class="steps">
      {
        steps.map((step) => (
          <li class="step">
            <span class="step-dot" data-enter="dot" aria-hidden="true" />
            <h3 class="step-title" data-enter="tilt">
              {step.title}
            </h3>
            <p class="step-body" data-enter="rise">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="process-side" aria-hidden="true">
    <div class="process-orbits" data-follow="500">
      <Orbits variant="rings" class="process-rings" />
    </div>
  </div>
</section>

<style>
  .process {
    position: relative;
    display: flex;
    overflow-x: clip;
  }
  .process-panel {
    flex: none;
    width: 65%;
    padding: 48px 24px;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--accent);
    color: var(--accent-text);
  }
  .steps {
    display: grid;
    gap: 24px;
  }
  .step-dot {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: currentColor;
  }
  .step-title {
    margin-top: 12px;
    font-size: 5.94728vw;
    font-weight: 700;
    line-height: 1.3;
  }
  .step-body {
    margin-top: 12px;
    font-size: 18px;
    line-height: 1.6;
  }
  .process-side {
    flex: 1;
    min-width: 0;
  }
  .process-orbits {
    position: sticky;
    top: 144px;
    margin-top: 98px;
    height: 133px;
  }
  .process-orbits :global(.process-rings) {
    width: 100%;
    height: 100%;
  }
  @media (min-width: 751px) {
    .process-panel {
      padding: 50vh 0 144px;
    }
    .steps {
      width: 480px;
      max-width: calc(100% - 48px);
      margin-inline: auto;
      gap: 96px;
    }
    .step-dot {
      width: 24px;
      height: 24px;
    }
    .step-title {
      margin-top: 24px;
      font-size: 34px;
    }
    .step-body {
      margin-top: 24.6px;
      font-size: 21px;
    }
    .process-orbits {
      top: 20vh;
      margin-block: 20vh;
      height: 60vh;
    }
  }
</style>
