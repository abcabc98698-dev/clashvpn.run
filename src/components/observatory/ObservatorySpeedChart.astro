---
import type { AirportBrand } from "../../data/brands";
import { DATA_STATUS_META } from "../../data/brands";

export interface Props {
  brand: AirportBrand;
}

const { brand } = Astro.props;
const statusMeta = DATA_STATUS_META[brand.benchmarkStatus] ?? DATA_STATUS_META[brand.dataStatus];
const hasMeasuredImage = Boolean(brand.speedtestImage?.file);

function getBarPercent(downloadStr: string): number {
  const num = parseFloat(downloadStr.replace(/[^0-9.]/g, ""));
  if (Number.isNaN(num) || num <= 0) return 55;
  return Math.min(96, Math.max(24, Math.round((num / 600) * 100)));
}
---

<div class="rounded-2xl border border-line bg-surface p-6 md:p-8">
  <div class="flex flex-wrap items-start justify-between gap-4 border-b border-line pb-5">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-accent"></span>
        <span class="font-mono text-xs tracking-wider text-muted uppercase">
          Performance Monitoring Report · 节点测速与线路档案
        </span>
      </div>
      <h3 class="mt-2 text-xl text-ink md:text-2xl">
        {brand.name} 节点延迟、吞吐表现与 2026-08-11 原始测速快照
      </h3>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span
        class:list={[
          "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium",
          statusMeta.badgeClass,
        ]}
      >
        <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
        {statusMeta.label}
      </span>
      <span class="rounded-full border border-line bg-bg/60 px-3 py-1 font-mono text-xs text-muted">
        协议：{brand.protocols.join(" / ")}
      </span>
    </div>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-12">
    <div class="space-y-4 lg:col-span-6">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-muted">
        <span>数据来源：{brand.benchmarkSource}</span>
        <span class="font-mono text-accent">{brand.lineType}</span>
      </div>

      {
        brand.benchmark.length > 0 ? (
          <div class="space-y-3.5">
            {brand.benchmark.map((node) => {
              const pct = getBarPercent(node.download);
              return (
                <div class="rounded-xl border border-line/80 bg-bg/50 p-3.5">
                  <div class="flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2">
                      <span class="rounded bg-accent/15 px-2 py-0.5 font-mono text-[11px] text-accent">
                        {node.region}
                      </span>
                      <span class="font-mono text-muted">延迟：{node.latency}</span>
                    </div>
                    <span class="font-mono text-xs font-semibold text-accent">
                      下行：{node.download}
                    </span>
                  </div>
                  <div class="mt-2.5 h-2 w-full overflow-hidden rounded-full bg-line/60">
                    <div
                      class="h-full rounded-full bg-gradient-to-r from-accent/60 to-accent"
                      style={`width: ${pct}%`}
                    />
                  </div>
                  {node.date && (
                    <div class="mt-1.5 flex justify-between font-mono text-[11px] text-muted">
                      <span>记录批次：{node.date}</span>
                      <span>状态：{statusMeta.label}</span>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        ) : (
          <div class="rounded-xl border border-line/80 bg-bg/50 p-5 text-xs leading-relaxed text-muted">
            本品牌暂无独立分区域数值表记录，请参考右侧原始截图或下方线路架构参数。
          </div>
        )
      }

      <div class="rounded-xl border border-line/70 bg-bg/40 p-3.5 text-xs leading-relaxed text-muted">
        <strong class="text-ink">数据口径说明：</strong>
        {statusMeta.description}。不同地区宽带运营商（电信 / 联通 / 移动）、晚高峰时段及客户端分流规则会影响实际速率，建议先用月付或小包实测本地晚高峰表现。
      </div>
    </div>

    <div class="lg:col-span-6">
      {
        hasMeasuredImage && brand.speedtestImage ? (
          <div class="flex h-full flex-col justify-between rounded-xl border border-accent/30 bg-bg/70 p-4">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 pb-3">
                <span class="inline-flex items-center gap-1.5 font-mono text-xs text-accent">
                  <span class="h-2 w-2 rounded-full bg-accent" />
                  实测原图存档 ({brand.speedtestImage.testedAt})
                </span>
                <span class="font-mono text-xs text-muted">
                  图内协议：{brand.speedtestImage.protocolDisplayed}
                </span>
              </div>
              <a
                href={brand.speedtestImage.file}
                target="_blank"
                rel="noopener"
                class="group relative block overflow-hidden rounded-lg border border-line bg-bg"
                title={`点击在新窗口查看 ${brand.name} 完整高清测速原图`}
              >
                <img
                  src={brand.speedtestImage.file}
                  alt={`${brand.name} ${brand.speedtestImage.testedAt} 节点延迟与吞吐实测原图`}
                  loading="lazy"
                  decoding="async"
                  class="max-h-72 w-full object-contain object-top transition duration-300 group-hover:scale-[1.02]"
                />
                <span class="
                  absolute right-2.5 bottom-2.5 rounded-md border border-line
                  bg-bg/90 px-2.5 py-1 text-[11px] text-ink backdrop-blur-sm
                  transition group-hover:border-accent group-hover:text-accent
                ">
                  点击放大查看原图 ↗
                </span>
              </a>
            </div>
            <div class="mt-3 space-y-1 text-xs leading-relaxed text-muted">
              <p>
                <strong class="text-ink">测速工具：</strong>{brand.speedtestImage.toolFamily} · {brand.speedtestImage.backendNote}
              </p>
              {brand.speedtestImage.reviewNote && <p>{brand.speedtestImage.reviewNote}</p>}
            </div>
          </div>
        ) : (
          <div class="flex h-full flex-col justify-between rounded-xl border border-line bg-bg/50 p-5">
            <div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs text-amber-300 uppercase">
                  Batch Snapshot Status · 批次截图状态
                </span>
                <span class="rounded border border-amber-400/30 bg-amber-400/10 px-2 py-0.5 text-[11px] text-amber-300">
                  未包含于 2026-08-11 截图包
                </span>
              </div>
              <h4 class="mt-3 text-base text-ink">
                当前展示为品牌披露参数与历史资料库存档
              </h4>
              <p class="mt-2 text-xs leading-relaxed text-muted">
                本品牌未包含在 2026-08-11 批次的 17 张客户端长图采样包中。根据 ClashVPN 订阅指南的「诚实内容防线」准则，我们绝不伪造或拼接其他品牌的测速图。
              </p>
              <ul class="mt-4 space-y-2 text-xs text-muted">
                <li class="flex items-start gap-2">
                  <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                  <span>披露线路架构：<strong class="text-ink">{brand.lineType}</strong></span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                  <span>支持传输协议：<strong class="text-ink">{brand.protocols.join(" / ")}</strong></span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                  <span>覆盖国家/地区：<strong class="text-ink">{brand.regions.join(" · ")}</strong></span>
                </li>
              </ul>
            </div>
            <div class="mt-5 rounded-lg border border-accent/25 bg-accent/5 p-3 text-xs text-muted">
              如果您需要具备 <strong class="text-ink">2026-08-11 实测截图验证</strong> 的高性价比专线，建议优先参考排名第 1 的 <a href="/brands/guangsuyun/" class="text-accent underline underline-offset-4">光速云 (IEPL+企业内网双专线)</a>。
            </div>
          </div>
        )
      }
    </div>
  </div>
</div>
